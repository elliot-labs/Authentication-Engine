{
    "name": "@elliot-labs/authentication-engine",
    "version": "2.0.0",
    "main": "bin/src/index.js",
    "type": "module",
    "description": "Provides Entra ID authentication and authorization capabilities.",
    "keywords": [
        "authentication",
        "authorization",
        "authn",
        "authz",
        "microsoft-entra-id",
        "entra-id",
        "azure-identity",
        "defaultazurecredential",
        "service-principal",
        "managed-identity",
        "workload-identity",
        "oauth2",
        "openid-connect",
        "oidc",
        "jwt",
        "jwks",
        "access-token",
        "token-validation",
        "express",
        "express-middleware",
        "typescript"
    ],
    "homepage": "https://github.com/elliot-labs/Authentication-Engine#readme",
    "bugs": {
        "url": "https://github.com/elliot-labs/Authentication-Engine/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elliot-labs/Authentication-Engine.git"
    },
    "license": "MIT",
    "packageManager": "npm@12.2.0",
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": ">=24.21.0",
            "onFail": "error"
        }
    },
    "author": {
        "name": "Elliot Huffman",
        "email": "ehuffman@elliot-labs.com",
        "url": "https://elliot-labs.com"
    },
    "scripts": {
        "build:Dev": "tsc",
        "prebuild:Prod": "tsc -p prod.tsconfig.json --emitDeclarationOnly false",
        "build:Prod": "tsc -p prod.tsconfig.json --removeComments false",
        "lint": "eslint --max-warnings 0",
        "test:Unit": "echo \"No unit tests yet!\"",
        "test:Integration": "echo \"No integration tests yet!\"",
        "prepare": "ts-patch install"
    },
    "devDependencies": {
        "@software-hardware-integration-lab/development-utilities": "~3.0.0",
        "@types/express": "~5.0.6",
        "@types/jws": "~3.2.11",
        "ts-patch": "~4.0.1",
        "typescript": "~6.0.3"
    },
    "peerDependencies": {
        "express": "^5.3.0"
    },
    "dependencies": {
        "@azure/identity": "~4.14.0",
        "typia": "~12.1.1"
    },
    "overrides": {
        "es-define-property": "npm:@socketregistry/es-define-property@^1",
        "function-bind": "npm:@socketregistry/function-bind@^1",
        "gopd": "npm:@socketregistry/gopd@^1",
        "has-symbols": "npm:@socketregistry/has-symbols@^1",
        "hasown": "npm:@socketregistry/hasown@^1",
        "is-core-module": "npm:@socketregistry/is-core-module@^1",
        "is-interactive": "npm:@socketregistry/is-interactive@^1",
        "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@^1",
        "path-parse": "npm:@socketregistry/path-parse@^1",
        "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
        "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
        "side-channel": "npm:@socketregistry/side-channel@^1"
    },
    "resolutions": {
        "es-define-property": "npm:@socketregistry/es-define-property@^1",
        "function-bind": "npm:@socketregistry/function-bind@^1",
        "gopd": "npm:@socketregistry/gopd@^1",
        "has-symbols": "npm:@socketregistry/has-symbols@^1",
        "hasown": "npm:@socketregistry/hasown@^1",
        "is-core-module": "npm:@socketregistry/is-core-module@^1",
        "is-interactive": "npm:@socketregistry/is-interactive@^1",
        "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@^1",
        "path-parse": "npm:@socketregistry/path-parse@^1",
        "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
        "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
        "side-channel": "npm:@socketregistry/side-channel@^1"
    }
